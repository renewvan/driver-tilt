{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://renewvan.dev/schema/node-manifest.schema.json",
  "title": "node-manifest",
  "description": "LOCAL TEST FIXTURE of renewvan/hub's node-manifest schema, written from renewvan/hub#36. Replace with the real schema's behaviour when hub#36 lands; CI validates against the real one at a pinned hub ref. version and host_serial are forbidden: they are stamped at runtime.",
  "type": "object",
  "properties": {
    "node": {
      "type": "string",
      "pattern": "^(?!demo$)(?!node-)[a-z][a-z0-9-]*$"
    },
    "product": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "publishes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "battery",
          "charger",
          "gps",
          "relay",
          "router",
          "solar",
          "tank",
          "temperature",
          "tilt"
        ]
      }
    },
    "manufacturer": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "minLength": 1 }
  },
  "required": ["node", "product", "source", "publishes"],
  "additionalProperties": false
}
