[Unit]
Description=node-tilt MQTT node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/node-tilt
ExecStart=/opt/node-tilt/.venv/bin/python -m node_tilt.main --config /opt/node-tilt/config.ini
Restart=on-failure
RestartSec=5
User=renewvan

[Install]
WantedBy=multi-user.target
